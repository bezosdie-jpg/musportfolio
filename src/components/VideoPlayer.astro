---
interface Props {
  src?: string;
  title: string;
  poster?: string;
  embedUrl?: string;
}
const { src, title, poster, embedUrl } = Astro.props;
const isEmbed = !!embedUrl;
const videoSrc = embedUrl || src;
---

<div class="video-player" data-src={videoSrc} data-title={title}>
  {isEmbed ? (
    <>
      {poster && (
        <div class="video-poster" style={{ backgroundImage: `url(${poster})` }} aria-hidden="true" data-poster="true"></div>
      )}
      <iframe
        id={`video-${title.replace(/\s+/g, '-').toLowerCase()}`}
        src=""
        title={title}
        allow="autoplay; fullscreen"
        allowfullscreen
        loading="lazy"
        data-src={videoSrc}
      ></iframe>
    </>
  ) : (
    <>
      <video
        id={`video-${title.replace(/\s+/g, '-').toLowerCase()}`}
        src={src}
        poster={poster}
        preload="metadata"
        aria-label={title}
      ></video>
      <div class="video-controls">
        <button
          class="play-btn"
          aria-label="Play"
          aria-pressed="false"
          data-action="play"
        >
          <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
          <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
        </button>
        <div class="time-display">
          <span class="current-time">0:00</span>
          <span class="separator" aria-hidden="true">/</span>
          <span class="duration">0:00</span>
        </div>
        <div class="seek-wrapper" data-action="seek" role="slider" aria-label="Seek" tabindex="0">
          <div class="seek-track" aria-hidden="true"></div>
          <div class="seek-progress" style="width: 0%"></div>
          <div class="seek-handle" aria-hidden="true"></div>
        </div>
        <div class="volume-control">
          <button class="volume-btn" aria-label="Mute" aria-pressed="false" data-action="volume-toggle">
            <svg class="icon-volume-high" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/></svg>
            <svg class="icon-volume-low" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.4.05-.61zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C22.14 14.82 22.5 13.33 22.5 12s-.36-2.82-.99-3.84l-1.51 1.51C20.48 9.67 21 10.55 21 12zM3 9v6h4l5 5V4L7 9H3v6zm3.61 1.5L14.5 12l7.89 7.88 1.38-1.38-7.88-7.88L7.9 5.12 6.61 6.41 12.5 12l-5.89 5.89 1.38 1.38L10.5 12 6.61 8.11 5.23 9.5 9.12 13.4 7.74 14.78 3 20.15 3 9h4.61z"/></svg>
            <svg class="icon-volume-mute" viewBox="0 0 24 24" aria-hidden="true"><path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.4.05-.61zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C22.14 14.82 22.5 13.33 22.5 12s-.36-2.82-.99-3.84l-1.51 1.51C20.48 9.67 21 10.55 21 12zM3 9v6h4l5 5V4L7 9H3v6zm3.61 1.5L14.5 12l7.89 7.88 1.38-1.38-7.88-7.88L7.9 5.12 6.61 6.41 12.5 12l-5.89 5.89 1.38 1.38L10.5 12 6.61 8.11 5.23 9.5 9.12 13.4 7.74 14.78 3 20.15 3 9h4.61z"/></svg>
          </button>
          <div class="volume-slider-wrapper">
            <input type="range" class="volume-slider" min="0" max="1" step="0.1" value="1" aria-label="Volume">
          </div>
        </div>
      </div>
    </>
  )}
</div>

<style>
  .video-player {
    position: relative;
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    background: #000;
    border-radius: 8px;
    overflow: hidden;
    font-family: inherit;
    font-size: 0.8125rem;
  }
  .video-player video,
  .video-player iframe {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
  }
  .video-poster {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    z-index: 2;
    cursor: pointer;
  }
  .video-player iframe {
    border: none;
    min-height: 360px;
    z-index: 1;
  }
  .video-controls {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.75rem;
    background: linear-gradient(transparent, rgba(0,0,0,0.8));
    color: #fff;
    z-index: 3;
  }
  .play-btn,
  .volume-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: none;
    background: rgba(255,255,255,0.9);
    color: #000;
    border-radius: 50%;
    cursor: pointer;
    transition: background 0.2s;
  }
  .play-btn:hover,
  .volume-btn:hover { background: #fff; }
  .play-btn:focus-visible,
  .volume-btn:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .icon-play { display: block; width: 14px; height: 14px; fill: currentColor; }
  .icon-pause { display: none; width: 14px; height: 14px; fill: currentColor; }
  .play-btn[aria-pressed="true"] .icon-play { display: none; }
  .play-btn[aria-pressed="true"] .icon-pause { display: block; }
  .time-display {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-variant-numeric: tabular-nums;
    min-width: 80px;
    font-size: 0.75rem;
  }
  .seek-wrapper {
    flex: 1;
    max-width: 200px;
    height: 4px;
    position: relative;
    cursor: pointer;
    border-radius: 2px;
    background: transparent;
  }
  .seek-track {
    width: 100%;
    height: 2px;
    background: rgba(255,255,255,0.3);
    border-radius: 1px;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
  }
  .seek-progress {
    position: absolute;
    top: 50%;
    left: 0;
    height: 2px;
    background: #fff;
    border-radius: 1px;
    pointer-events: none;
    transform: translateY(-50%);
    transition: width 0.1s linear;
  }
  .seek-handle {
    position: absolute;
    top: 50%;
    left: 0;
    width: 12px;
    height: 12px;
    background: #fff;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity 0.15s;
    pointer-events: none;
  }
  .seek-wrapper:hover .seek-handle,
  .seek-wrapper:focus-within .seek-handle,
  .seek-wrapper.dragging .seek-handle { opacity: 1; }
  .volume-control {
    position: relative;
    display: flex;
    align-items: center;
  }
  .volume-btn svg { width: 14px; height: 14px; fill: currentColor; }
  .icon-volume-high { display: block; }
  .icon-volume-low { display: none; }
  .icon-volume-mute { display: none; }
  .volume-btn[aria-pressed="true"] .icon-volume-high { display: none; }
  .volume-btn[aria-pressed="true"] .icon-volume-mute { display: block; }
  .volume-btn:not([aria-pressed="true"]):has(+ .volume-slider-wrapper:hover) .icon-volume-high { display: none; }
  .volume-btn:not([aria-pressed="true"]):has(+ .volume-slider-wrapper:hover) .icon-volume-low { display: block; }
  .volume-slider-wrapper {
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    padding: 0.375rem 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s, visibility 0.15s;
    pointer-events: none;
  }
  .volume-control:hover .volume-slider-wrapper,
  .volume-control:focus-within .volume-slider-wrapper {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .volume-slider {
    width: 100%;
    height: 4px;
    -webkit-appearance: none;
    appearance: none;
    background: rgba(255,255,255,0.3);
    border-radius: 2px;
    outline: none;
    cursor: pointer;
  }
  .volume-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 12px;
    height: 12px;
    background: #fff;
    border-radius: 50%;
    cursor: pointer;
    transition: transform 0.1s;
  }
  .volume-slider::-webkit-slider-thumb:hover { transform: scale(1.2); }
  .volume-slider::-moz-range-thumb {
    width: 12px;
    height: 12px;
    background: #fff;
    border: none;
    border-radius: 50%;
    cursor: pointer;
  }
  @media (prefers-reduced-motion: reduce) {
    .play-btn, .volume-btn,
    .seek-progress, .seek-handle, .volume-slider {
      transition: none;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const players = document.querySelectorAll('.video-player');
    players.forEach(player => {
      const video = player.querySelector('video');
      const iframe = player.querySelector('iframe');
      const playBtn = player.querySelector('.play-btn');
      const currentTimeEl = player.querySelector('.current-time');
      const durationEl = player.querySelector('.duration');
      const poster = player.querySelector('.video-poster');
      const seekWrapper = player.querySelector('.seek-wrapper');
      const seekProgress = player.querySelector('.seek-progress');
      const seekHandle = player.querySelector('.seek-handle');
      const volumeBtn = player.querySelector('.volume-btn');
      const volumeSlider = player.querySelector('.volume-slider');
      const volumeSliderWrapper = player.querySelector('.volume-slider-wrapper');
      const dataSrc = player.getAttribute('data-src');

      if (!video && !iframe) return;

      // === EMBED MODE (Google Drive) ===
      if (iframe && poster) {
        let started = false;

        poster.addEventListener('click', () => {
          if (started) return;
          started = true;
          poster.style.display = 'none';
          const finalSrc = dataSrc.includes('?') ? `${dataSrc}&autoplay=1` : `${dataSrc}?autoplay=1`;
          iframe.src = finalSrc;
        });
      }

      // === LOCAL VIDEO MODE ===
      if (!video) return;

      const formatTime = (seconds) => {
        if (isNaN(seconds)) return '0:00';
        const mins = Math.floor(seconds / 60);
        const secs = Math.floor(seconds % 60).toString().padStart(2, '0');
        return `${mins}:${secs}`;
      };

      video.addEventListener('loadedmetadata', () => {
        durationEl.textContent = formatTime(video.duration);
        if (poster) poster.style.display = 'none';
      });

      video.addEventListener('timeupdate', () => {
        currentTimeEl.textContent = formatTime(video.currentTime);
        const percent = (video.currentTime / video.duration) * 100;
        seekProgress.style.width = `${percent}%`;
        seekHandle.style.left = `${percent}%`;
      });

      let isSeeking = false;
      seekWrapper.addEventListener('mousedown', (e) => {
        isSeeking = true;
        seekWrapper.classList.add('dragging');
        const rect = seekWrapper.getBoundingClientRect();
        const percent = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
        video.currentTime = percent * video.duration;
      });
      document.addEventListener('mousemove', (e) => {
        if (!isSeeking) return;
        const rect = seekWrapper.getBoundingClientRect();
        const percent = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
        video.currentTime = percent * video.duration;
      });
      document.addEventListener('mouseup', () => {
        if (isSeeking) {
          isSeeking = false;
          seekWrapper.classList.remove('dragging');
        }
      });
      seekWrapper.addEventListener('touchstart', (e) => {
        isSeeking = true;
        seekWrapper.classList.add('dragging');
        const rect = seekWrapper.getBoundingClientRect();
        const percent = Math.max(0, Math.min(1, (e.touches[0].clientX - rect.left) / rect.width));
        video.currentTime = percent * video.duration;
      }, { passive: true });
      document.addEventListener('touchmove', (e) => {
        if (!isSeeking) return;
        const rect = seekWrapper.getBoundingClientRect();
        const percent = Math.max(0, Math.min(1, (e.touches[0].clientX - rect.left) / rect.width));
        video.currentTime = percent * video.duration;
      }, { passive: true });
      document.addEventListener('touchend', () => {
        if (isSeeking) {
          isSeeking = false;
          seekWrapper.classList.remove('dragging');
        }
      });

      playBtn.addEventListener('click', () => {
        if (video.paused) {
          video.play();
          playBtn.setAttribute('aria-pressed', 'true');
          playBtn.setAttribute('aria-label', 'Pause');
        } else {
          video.pause();
          playBtn.setAttribute('aria-pressed', 'false');
          playBtn.setAttribute('aria-label', 'Play');
        }
      });

      video.addEventListener('play', () => {
        playBtn.setAttribute('aria-pressed', 'true');
        playBtn.setAttribute('aria-label', 'Pause');
      });

      video.addEventListener('pause', () => {
        playBtn.setAttribute('aria-pressed', 'false');
        playBtn.setAttribute('aria-label', 'Play');
      });

      video.addEventListener('ended', () => {
        playBtn.setAttribute('aria-pressed', 'false');
        playBtn.setAttribute('aria-label', 'Play');
        seekProgress.style.width = '0%';
        seekHandle.style.left = '0%';
      });

      const updateVolumeUI = () => {
        const vol = video.volume;
        const isMuted = video.muted || vol === 0;
        volumeBtn.setAttribute('aria-pressed', isMuted.toString());
        volumeBtn.setAttribute('aria-label', isMuted ? 'Unmute' : 'Mute');
        volumeSlider.value = vol;
        volumeBtn.querySelector('.icon-volume-high').style.display = (!isMuted && vol > 0.5) ? 'block' : 'none';
        volumeBtn.querySelector('.icon-volume-low').style.display = (!isMuted && vol > 0 && vol <= 0.5) ? 'block' : 'none';
        volumeBtn.querySelector('.icon-volume-mute').style.display = isMuted ? 'block' : 'none';
      };

      volumeBtn.addEventListener('click', () => {
        video.muted = !video.muted;
        updateVolumeUI();
      });

      volumeSlider.addEventListener('input', (e) => {
        video.volume = parseFloat(e.target.value);
        video.muted = false;
        updateVolumeUI();
      });

      video.addEventListener('volumechange', updateVolumeUI);

      poster?.addEventListener('click', () => {
        video.play();
      });
      video.addEventListener('play', () => {
        if (poster) poster.style.display = 'none';
      });
      video.addEventListener('pause', () => {
        if (poster && video.currentTime === 0) poster.style.display = '';
      });

      player.addEventListener('keydown', (e) => {
        switch (e.key) {
          case ' ':
          case 'k':
            e.preventDefault();
            playBtn.click();
            break;
          case 'ArrowLeft':
            e.preventDefault();
            video.currentTime = Math.max(0, video.currentTime - 5);
            break;
          case 'ArrowRight':
            e.preventDefault();
            video.currentTime = Math.min(video.duration, video.currentTime + 5);
            break;
          case 'ArrowUp':
            e.preventDefault();
            video.volume = Math.min(1, video.volume + 0.1);
            updateVolumeUI();
            break;
          case 'ArrowDown':
            e.preventDefault();
            video.volume = Math.max(0, video.volume - 0.1);
            updateVolumeUI();
            break;
          case 'm':
            video.muted = !video.muted;
            updateVolumeUI();
            break;
        }
      });
    });
  });
</script>

