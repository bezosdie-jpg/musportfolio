---
interface Props {
  src: string;
  title: string;
}

const { src, title } = Astro.props;

// На продакшене с base '/musportfolio/' Astro сам добавит base к относительным путям,
// но для <audio src> явно склеиваем, чтобы не было 404 на GitHub Pages.
const audioSrc = import.meta.env.PROD && !src.startsWith('http')
  ? `/musportfolio/${src.replace(/^\//, '')}`
  : src;
---

<div class="audio-player" data-src={audioSrc}>
  <audio
    id={`audio-${title.replace(/\s+/g, '-').toLowerCase()}`}
    src={audioSrc}
    preload="metadata"
    aria-label={title}
    crossorigin="anonymous"
  ></audio>
  <div class="audio-controls">
    <button
      class="play-btn"
      aria-label="Play"
      aria-pressed="false"
      data-action="play"
    >
      <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
      <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
    </button>
    <div class="time-display">
      <span class="current-time">0:00</span>
      <span class="separator" aria-hidden="true">/</span>
      <span class="duration">0:00</span>
    </div>
    <div class="seek-wrapper" data-action="seek">
      <div class="seek-track" aria-hidden="true"></div>
      <div class="seek-progress" style="width: 0%"></div>
    </div>
  </div>
</div>

<style>
  .audio-player {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: #f5f5f5;
    border-radius: 8px;
    font-family: inherit;
    font-size: 0.875rem;
  }
  .audio-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
  }
  .play-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: none;
    background: #000;
    color: #fff;
    border-radius: 50%;
    cursor: pointer;
    transition: background 0.2s;
  }
  .play-btn:hover { background: #333; }
  .play-btn:focus-visible { outline: 2px solid #000; outline-offset: 2px; }
  .icon-play { display: block; width: 20px; height: 20px; fill: currentColor; }
  .icon-pause { display: none; width: 20px; height: 20px; fill: currentColor; }
  .play-btn[aria-pressed="true"] .icon-play { display: none; }
  .play-btn[aria-pressed="true"] .icon-pause { display: block; }
  .time-display {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-variant-numeric: tabular-nums;
    color: #666;
    min-width: 100px;
  }
  .seek-wrapper {
    flex: 1;
    max-width: 320px;
    height: 2px;
    position: relative;
    cursor: pointer;
    border-radius: 1px;
    background: transparent;
    margin-left: 1rem;
  }
  .seek-track {
    width: 100%;
    height: 2px;
    background: #ddd;
    border-radius: 1px;
  }
  .seek-progress {
    position: absolute;
    top: 0;
    left: 0;
    height: 2px;
    background: #000;
    border-radius: 1px;
    pointer-events: none;
    transition: width 0.1s linear;
  }
  @media (prefers-reduced-motion: reduce) {
    .play-btn, .seek-progress { transition: none; }
  }
</style>

<script>
  let currentlyPlaying = null;

  document.addEventListener('DOMContentLoaded', () => {
    const players = document.querySelectorAll('.audio-player');
    players.forEach((player) => {
      const audio = player.querySelector('audio');
      const playBtn = player.querySelector('.play-btn');
      const seekWrapper = player.querySelector('.seek-wrapper');
      const seekProgress = player.querySelector('.seek-progress');
      const currentTimeEl = player.querySelector('.current-time');
      const durationEl = player.querySelector('.duration');

      const formatTime = (seconds) => {
        if (isNaN(seconds)) return '0:00';
        const mins = Math.floor(seconds / 60);
        const secs = Math.floor(seconds % 60).toString().padStart(2, '0');
        return `${mins}:${secs}`;
      };

      audio.addEventListener('loadedmetadata', () => {
        durationEl.textContent = formatTime(audio.duration);
      });

      audio.addEventListener('error', (e) => {
        console.error('Audio load error:', e);
      });

      audio.addEventListener('timeupdate', () => {
        const percent = (audio.currentTime / audio.duration) * 100;
        seekProgress.style.width = `${percent}%`;
        currentTimeEl.textContent = formatTime(audio.currentTime);
      });

      playBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (audio.paused) {
          if (currentlyPlaying && currentlyPlaying !== audio) {
            currentlyPlaying.pause();
            const prevPlayer = currentlyPlaying.closest('.audio-player');
            const prevBtn = prevPlayer?.querySelector('.play-btn');
            prevBtn?.setAttribute('aria-pressed', 'false');
            prevBtn?.setAttribute('aria-label', 'Play');
          }
          audio.play().catch(() => {});
          currentlyPlaying = audio;
          playBtn.setAttribute('aria-pressed', 'true');
          playBtn.setAttribute('aria-label', 'Pause');
        } else {
          audio.pause();
          playBtn.setAttribute('aria-pressed', 'false');
          playBtn.setAttribute('aria-label', 'Play');
        }
      });

      audio.addEventListener('ended', () => {
        playBtn.setAttribute('aria-pressed', 'false');
        playBtn.setAttribute('aria-label', 'Play');
        seekProgress.style.width = '0%';
        if (currentlyPlaying === audio) {
          currentlyPlaying = null;
        }
      });

      seekWrapper.addEventListener('click', (e) => {
        e.stopPropagation();
        const rect = seekWrapper.getBoundingClientRect();
        const percent = (e.clientX - rect.left) / rect.width;
        audio.currentTime = percent * audio.duration;
      });

      player.addEventListener('keydown', (e) => {
        switch (e.key) {
          case ' ':
          case 'k':
            e.preventDefault();
            playBtn.click();
            break;
          case 'ArrowLeft':
            e.preventDefault();
            audio.currentTime = Math.max(0, audio.currentTime - 5);
            break;
          case 'ArrowRight':
            e.preventDefault();
            audio.currentTime = Math.min(audio.duration, audio.currentTime + 5);
            break;
          case 'ArrowUp':
            e.preventDefault();
            audio.volume = Math.min(1, audio.volume + 0.1);
            break;
          case 'ArrowDown':
            e.preventDefault();
            audio.volume = Math.max(0, audio.volume - 0.1);
            break;
          case 'm':
            audio.muted = !audio.muted;
            break;
        }
      });
    });
  });
</script>

