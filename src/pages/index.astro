---
import Layout from '../layouts/Layout.astro';
import WorkCard from '../components/WorkCard.astro';
import works from '../data/works.json';
import Header from '../components/Header.astro';
---
<Layout title="Portfolio">
  <Header />
  <main class="main">
    <section class="hero" aria-labelledby="hero-title">
      <h1 id="hero-title" class="hero-title">Portfolio</h1>
      <p class="hero-subtitle">Music compositions & video works</p>
    </section>
    <section class="works" aria-labelledby="works-title">
      <h2 id="works-title" class="section-title">Works</h2>
      <div class="works-grid">
        {works.map((work) => (
          <WorkCard work={work} />
        ))}
      </div>
    </section>
    <section class="about" aria-labelledby="about-title">
      <h2 id="about-title" class="section-title">About</h2>
      <div class="about-content">
        <p>лёня - музыка, звук, саундддизайн, диггинг.</p>
        <p>Люблю работать с гитарным звуков, читаю лекции о музыку, преподаю музыку. В основе подхода: психоакустика, активное слушанье, преданность)</p>
        <div class="contacts">
          <a href="https://t.me/eylenen"_blank" rel="noopener" class="contact-link">тг</a>
          
        </div>
      </div>
    </section>
  </main>
  <footer class="footer">
    </p> GitHub.Asto. Модели Antropic и OpenAi </p>
  </footer>
</Layout>